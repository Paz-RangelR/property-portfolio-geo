# Copy to .env and fill in. NEVER commit .env — see .gitignore
# The demos need NONE of these: DEMO_MODE=1 reads local fixtures.

SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=SVC_ANALYTICS
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_WAREHOUSE=WH_ANALYTICS
SNOWFLAKE_DATABASE=DB_ANALYTICS
SNOWFLAKE_SCHEMA=SCH_CORE
SNOWFLAKE_ROLE=ROLE_ANALYTICS

# Shiny app users: user:hash pairs separated by ';'. Hashes, never passwords.
# Generate each hash once:  Rscript -e 'source("R/auth.R"); cat(hash_password("..."))'
APP_USERS=

# Google Places, used only by python/enriquecer_gmaps.py
GOOGLE_MAPS_API_KEY=
